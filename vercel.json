{
  "version": 2,
  "public": true,
  "routes": [
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|html))",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "destination": "/backend/test.js"
    },
    {
      "src": "/(.*)",
      "destination": "/backend/test.js"
    }
  ]
}